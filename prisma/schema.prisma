generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  notes HpBuildingNote[]
  history HpBuildingHistory[]
  imports HpExcelImport[]
  createdAt DateTime @default(now())
}

model HpProject {
  id String @id @default(cuid())
  projectId String
  projectType String
  centralName String?
  projectYear Int?
  lastImportId String?
  buildings HpBuilding[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId, projectType])
  @@index([centralName, projectYear])
}

model HpBuilding {
  id String @id @default(cuid())
  projectRefId String
  project HpProject @relation(fields: [projectRefId], references: [id], onDelete: Cascade)
  sourceKey String
  isActive Boolean @default(true)
  isCancelled Boolean @default(false)
  uavt String?
  district String?
  neighborhood String?
  street String?
  buildingName String?
  doorNumber String?
  bbkHp Int @default(0)
  pstn Int?
  dsl Int?
  infrastructureStatus String?
  workProgressDate DateTime?
  rekorDate DateTime?
  equivalentBuildingCode String?
  csbmCode String?
  cableCompleted Boolean @default(false)
  cableCompletedAt DateTime?
  spliceCompleted Boolean @default(false)
  spliceCompletedAt DateTime?
  obkCompleted Boolean @default(false) @map("ibkCompleted")
  obkCompletedAt DateTime? @map("ibkCompletedAt")
  notes HpBuildingNote[]
  history HpBuildingHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectRefId, sourceKey])
  @@index([uavt])
  @@index([district, neighborhood, street, doorNumber])
}

model HpBuildingNote {
  id String @id @default(cuid())
  buildingId String
  building HpBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  note String
  createdBy String
  user User @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  @@index([buildingId, createdAt])
}

model HpBuildingHistory {
  id String @id @default(cuid())
  buildingId String
  building HpBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  actionType String
  previousValue String?
  newValue String?
  description String
  createdBy String
  user User @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  @@index([buildingId, createdAt])
}

model HpExcelImport {
  id String @id @default(cuid())
  projectType String
  fileName String
  importedBy String
  user User @relation(fields: [importedBy], references: [id])
  importedAt DateTime @default(now())
  totalRows Int
  newProjects Int @default(0)
  newBuildings Int @default(0)
  updatedBuildings Int @default(0)
  archivedBuildings Int @default(0)
  skippedRows Int @default(0)
  errorRows Int @default(0)
  status String
  errorReport String?
}

// Independent snapshots keep monthly production history across Excel replacement.
model HpMonthlyCompletion {
  id String @id @default(cuid())
  projectId String
  projectType String
  sourceKey String
  uavt String?
  district String?
  neighborhood String?
  street String?
  buildingName String?
  doorNumber String?
  hp Int
  month String
  origin String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@unique([projectType, projectId, sourceKey])
  @@index([month, projectType])
}

// Daily building reports. Items are snapshots with no relation to HpBuilding.
// Partial unique indexes and immutability triggers live in migrations/0006.
model DailyReport {
  id String @id @default(cuid())
  status String @default("DRAFT")
  reportDate String?
  sequence Int?
  title String?
  totalBuildings Int?
  completedBuildings Int?
  completedHp Int?
  problemBuildings Int?
  problemHp Int?
  cancelledBuildings Int?
  cancelledHp Int?
  finalizedAt BigInt?
  createdAt BigInt
  updatedAt BigInt
  items DailyReportItem[]
}

model DailyReportItem {
  id String @id @default(cuid())
  reportId String
  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  projectType String
  projectId String
  sourceKey String
  buildingRefId String?
  neighborhood String @default("")
  address String @default("")
  hp Int @default(0)
  status String
  note String @default("")
  createdAt BigInt
  updatedAt BigInt
  @@unique([reportId, projectType, projectId, sourceKey])
  @@index([reportId])
}
